{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev", "--env=prod"],
      "port": 3000
    },
    {
      "name": "electron",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "electron"],
      "port": 3000
    },
    {
      "name": "electron-prod",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "electron", "--env=prod"],
      "port": 3000
    }
  ]
}
