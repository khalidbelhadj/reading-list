{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/routes/**/*.{ts,tsx}",
    "app/server.ts",
    "app/router.tsx",
    "app/start.ts",
    "electron/main.ts",
    "electron/*preload*.ts",
    "scripts/**/*.ts",
    "app/actions/index.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "db/**/*.ts",
    "electron/**/*.ts",
    "types/**/*.ts"
  ],
  "ignore": ["app/routeTree.gen.ts"],
  "ignoreDependencies": [
    "@fontsource-variable/dm-sans",
    "@fontsource/dm-mono",
    "tailwindcss",
    "tw-animate-css",
    "react-devtools",
    "shadcn",
    "supabase"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "enumMembers": "warn",
    "duplicates": "warn",
    "unresolved": "warn"
  }
}
