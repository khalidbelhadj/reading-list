{
  "manifest_version": 3,
  "name": "Reading List",
  "version": "1.0.0",
  "description": "Save the current page to your reading list, then jump straight to your notes.",
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://reading-list.khalidbelhadj.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Reading List",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "save-current-page": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save the current page to your reading list"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
