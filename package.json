{
  "name": "reading-list",
  "productName": "Reading List",
  "version": "0.1.3",
  "description": "Reading list desktop client",
  "author": "Khalid Belhadj",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite dev",
    "dev:nobanner": "NEXT_PUBLIC_DEV_BANNER=off vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "db:push": "drizzle-kit push",
    "db:setup": "bun db/setup.ts",
    "db:setup-local": "bun scripts/setup-local-supabase.ts",
    "db:seed": "bun db/seed.ts",
    "env:local": "bun scripts/use-supabase.ts local",
    "env:prod": "bun scripts/use-supabase.ts prod",
    "db:prune-orphan-tags": "bun scripts/prune-orphan-tags.ts",
    "analyze": "bun scripts/analyze-complexity.ts && bun scripts/build-complexity-report.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && eslint . --max-warnings 0",
    "prepare": "husky",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:start": "bun run electron:build && electron .",
    "electron:dev": "bun scripts/electron-dev.ts",
    "electron:local": "bun scripts/dev-electron.ts local",
    "electron:prod": "bun scripts/dev-electron.ts prod",
    "electron:pack": "bun run electron:build && electron-builder --mac --arm64",
    "electron:release": "bun run electron:build && electron-builder --mac --arm64 --publish always"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{mjs,cjs,json,css,html}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/react": "^4.0.16",
    "@base-ui/react": "^1.1.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/dm-mono": "^5.2.7",
    "@napi-rs/canvas": "^1.0.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.27",
    "@tanstack/react-virtual": "^3.14.3",
    "@tiptap/extension-code-block-lowlight": "^3.26.0",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-mathematics": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "ai": "^7.0.15",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "highlight.js": "^11.11.1",
    "highlightjs-odin": "^1.0.1",
    "highlightjs-zig": "^1.0.2",
    "katex": "^0.17.0",
    "lowlight": "^3.3.0",
    "motion": "^12.38.0",
    "pdfjs-dist": "^6.0.227",
    "postgres": "^3.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/bun": "^1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.30.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-devtools": "^7.0.1",
    "shadcn": "^3.8.2",
    "supabase": "^2.109.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "wait-on": "^9.0.10",
    "zod-validation-error": "^5.0.0"
  }
}
